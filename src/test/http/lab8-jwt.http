// Task №8. JWT

### 1. Get JWT token for admin
POST http://localhost:8080/api/v1/auth/authenticate
Content-Type: application/json

{
  "email": "admin@websecurity.local",
  "password": "admin"
}

> {%
    client.test("status 200", () => client.assert(response.status === 200));
    client.global.set("admin_token", response.body.token);
%}

### 2. Get JWT token for user
POST http://localhost:8080/api/v1/auth/authenticate
Content-Type: application/json

{
  "email": "user@websecurity.local",
  "password": "user"
}

> {%
    client.test("status 200", () => client.assert(response.status === 200));
    client.global.set("user_token", response.body.token);
%}

### 3. Get JWT token for superadmin
POST http://localhost:8080/api/v1/auth/authenticate
Content-Type: application/json

{
  "email": "superadmin@websecurity.local",
  "password": "superadmin"
}

> {%
    client.test("status 200", () => client.assert(response.status === 200));
    client.global.set("superadmin_token", response.body.token);
%}

### 4. Wrong password (expect 401 or 403)
POST http://localhost:8080/api/v1/auth/authenticate
Content-Type: application/json

{
  "email": "admin@websecurity.local",
  "password": "wrong"
}

> {%
    client.test("status 401 or 403", () => client.assert(response.status === 401 || response.status === 403));
%}
