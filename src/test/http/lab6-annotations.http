### 1. admin -> /api/v1/access/hello-admin (expect 200)
GET http://localhost:8080/api/v1/access/hello-admin
Authorization: Basic admin admin

> {%
    client.test("1. admin -> /api/v1/access/hello-admin (expect 200)", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

