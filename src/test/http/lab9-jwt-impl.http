### 1. Login as admin
POST http://localhost:8080/api/v1/auth/authenticate
Content-Type: application/json

{
  "email": "admin@websecurity.local",
  "password": "admin"
}

> {%
    client.test("1. Login as admin", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.global.set("admin_token", response.body.token);
%}

### 2. Login as user
POST http://localhost:8080/api/v1/auth/authenticate
Content-Type: application/json

{
  "email": "user@websecurity.local",
  "password": "user"
}

> {%
    client.test("2. Login as user", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.global.set("user_token", response.body.token);
%}

### 3. Login as superadmin
POST http://localhost:8080/api/v1/auth/authenticate
Content-Type: application/json

{
  "email": "superadmin@websecurity.local",
  "password": "superadmin"
}

> {%
    client.test("3. Login as superadmin", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.global.set("superadmin_token", response.body.token);
%}

### 4. admin -> hello-admin (expect 200)
GET http://localhost:8080/api/v1/access/hello-admin
Authorization: Bearer {{admin_token}}

> {%
    client.test("4. admin -> hello-admin", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### 5. admin -> hello-user (expect 403)
GET http://localhost:8080/api/v1/access/hello-user
Authorization: Bearer {{admin_token}}

> {%
    client.test("5. admin -> hello-user", function () {
        client.assert(response.status === 403, "Expected 403, got " + response.status);
    });
%}

