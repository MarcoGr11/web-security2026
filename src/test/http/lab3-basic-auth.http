### 7. Update — happy
# CSRF protection blocks non-GET requests by default, so valid credentials still get 401.
PUT http://localhost:8080/api/v1/books/3
Authorization: Basic admin admin
Accept: application/json
Content-Type: application/json

{
  "id": "3",
  "name": "Shadows of Forgotten Ancestors",
  "description": "Updated description",
  "author": "Mykhailo Kotsiubynsky",
  "year": 1912
}

> {%
    client.test("7. Update — happy", function () {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

