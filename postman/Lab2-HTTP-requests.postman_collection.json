          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"Book 3 updated\", () => pm.expect(b).to.eql({\"id\": \"3\", \"name\": \"Updated Book\", \"description\": \"Updated description\", \"author\": \"Updated Author\", \"year\": 2000}));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
