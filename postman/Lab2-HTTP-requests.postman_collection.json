      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"3 books, no id 4\", () => { pm.expect(b).to.have.lengthOf(3); pm.expect(b.map(x => x.id)).to.not.include(\"4\"); });"
