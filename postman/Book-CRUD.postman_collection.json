    {
      "name": "4. POST create",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"id matches\", () => pm.expect(b.id).to.eql(pm.collectionVariables.get(\"newBookId\")));",
              "pm.test(\"name matches\", () => pm.expect(b.name).to.eql(\"Test Book\"));",
              "pm.test(\"description matches\", () => pm.expect(b.description).to.eql(\"Created by Postman\"));",
              "pm.test(\"author matches\", () => pm.expect(b.author).to.eql(\"Test Author\"));",
              "pm.test(\"year matches\", () => pm.expect(b.year).to.eql(2024));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{newBookId}}\",\n  \"name\": \"Test Book\",\n  \"description\": \"Created by Postman\",\n  \"author\": \"Test Author\",\n  \"year\": 2024\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
