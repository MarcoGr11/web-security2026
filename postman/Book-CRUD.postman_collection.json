{
  "info": {
    "name": "Book CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET all",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"is array\", () => pm.expect(b).to.be.an(\"array\"));",
              "pm.test(\"length >= 3\", () => pm.expect(b.length).to.be.at.least(3));",
              "pm.test(\"every item has all fields\", () => b.forEach(x => [\"id\", \"name\", \"description\", \"author\", \"year\"].forEach(f => pm.expect(x).to.have.property(f))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ]
        }
      }
    },
    {
      "name": "2. GET by id (1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"has id\", () => pm.expect(b).to.have.property(\"id\"));",
              "pm.test(\"has name\", () => pm.expect(b).to.have.property(\"name\"));",
              "pm.test(\"has description\", () => pm.expect(b).to.have.property(\"description\"));",
              "pm.test(\"has author\", () => pm.expect(b).to.have.property(\"author\"));",
              "pm.test(\"has year\", () => pm.expect(b).to.have.property(\"year\"));",
              "pm.test(\"id is 1\", () => pm.expect(b.id).to.eql(\"1\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books",
            "1"
          ]
        }
      }
